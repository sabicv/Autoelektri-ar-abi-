# Supabase project URL and API keys.
# Find these in your Supabase project: Settings -> API.

# Safe to expose in the browser (used by the client SDK).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security — never expose to the client
# or commit the real value. Used for admin tasks (tenant onboarding,
# seeding, signed URL generation for the job-vault bucket).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Vapi.ai — AI voice agent for incoming calls.
# Server URL Secret configured in the Vapi dashboard for this assistant's
# webhook; sent back as the x-vapi-secret header on every request so we can
# verify it's really Vapi calling. If unset, verification is skipped
# (local dev only — always set this in production).
VAPI_SERVER_SECRET=your-vapi-server-url-secret
# Pre-configured assistant id (voice, model, transcriber set up in the Vapi
# dashboard). This webhook only overrides firstMessage + the system prompt
# per call. If unset, a full inline assistant definition is used as a
# standalone fallback.
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# Meta WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
# Graph API version — bump when Meta deprecates the current one.
WHATSAPP_API_VERSION=v21.0
# App secret from Meta App Dashboard > Settings > Basic. Used to verify the
# X-Hub-Signature-256 header on incoming webhook deliveries.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Arbitrary string you choose; must match what you enter in the Meta
# dashboard's webhook verification step (GET handshake).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-verify-token
# Names of the approved WhatsApp Message Templates (created in Meta
# Business Manager) used for proactive/cold-outbound notifications.
WHATSAPP_TEMPLATE_JOB_FINISHED=job_finished_notice
WHATSAPP_TEMPLATE_UPSELL_REQUEST=upsell_request
WHATSAPP_TEMPLATE_DIAGNOSTIC_COMPLETE=diagnostic_complete

# Cron protection (app/api/cron/parking-check). Set this in your Vercel
# project's env vars — Vercel then automatically sends it as
# `Authorization: Bearer $CRON_SECRET` on scheduled cron invocations (see
# vercel.json). The route fails CLOSED (rejects everything) if unset,
# since it mutates billing-affecting data.
CRON_SECRET=generate-a-long-random-string
